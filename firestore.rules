rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if isOwner(uid);
      allow read, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
      match /devices/{token} { allow read, write: if isOwner(uid) || isAdmin(); }
    }
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow create: if isAdmin() || (signedIn() && request.resource.data.sellerId == request.auth.uid);
      allow update, delete: if isAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
    }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptUrl','status','receiptUploadedAt','updatedAt']));
      allow delete: if isAdmin();
      match /items/{itemId} { allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/orders/$(id)).data.customerId == request.auth.uid); allow write: if false; }
    }
    match /seller_subscriptions/{id} { allow read: if isAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid); allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid; allow update: if isAdmin(); allow delete: if isAdmin(); }
    match /transfer_receipts/{id} { allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid); allow write: if signedIn(); }
    match /app_settings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
  }
}
